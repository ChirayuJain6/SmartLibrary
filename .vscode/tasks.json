{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SmartLibrary: Compile",
            "type": "shell",
            "command": "javac -d out src/models/*.java src/services/*.java src/ui/*.java src/main/*.java",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": "$javac"
        },
        {
            "label": "SmartLibrary: Run",
            "type": "shell",
            "command": "java -cp out main.Main",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "SmartLibrary: Compile",
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
